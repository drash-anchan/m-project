# Copy this file to server/.env and fill in real values.
# Never commit the real .env file — it holds live credentials.

PORT=5000

# ---------------------------------------------------------------------------
# Channel split
# ---------------------------------------------------------------------------
#   SMS      -> MSG91   (India-native, DLT-registered sender IDs)
#   AI call  -> Twilio  (programmable voice + text-to-speech)
#
# Each channel is resolved independently, so you can go live on SMS while the
# AI call is still simulated, or the other way round. GET /api/health always
# reports exactly which provider each channel is using and whether it is real.

# --- Demo mode ---
# true  = always simulate SMS/calls (no paid account needed at all — good for demos/judging)
# false = always send for real (fails with a clear credential error if the keys below are blank)
# unset = auto — real if that channel's credentials are filled in, simulated otherwise
#
# Leave this at true until you have real credentials, then set it to false (or
# delete the line) to dispatch for real.
DEMO_MODE=true

# Optional per-channel overrides: msg91 | twilio | mock
# Useful for forcing Twilio SMS while testing with a non-Indian number.
# SMS_PROVIDER=
# VOICE_PROVIDER=

# ---------------------------------------------------------------------------
# MSG91 — SMS  (https://msg91.com — dashboard > Settings > API)
# ---------------------------------------------------------------------------
# India's TRAI/DLT rules require a registered sender ID and an approved content
# template for commercial SMS; carriers filter anything else, which is why SMS
# goes through MSG91 rather than Twilio. You need a DLT-registered Principal
# Entity (free, via your telecom operator's DLT portal) before sends will land.
MSG91_AUTHKEY=

# Pick ONE of the two paths below.
#
# (A) Flow API v5 — recommended and DLT-correct. Create a template in the MSG91
#     dashboard containing a single variable, get it approved, then put its ID
#     here. MSG91_MESSAGE_VAR must match the variable name in that template.
MSG91_TEMPLATE_ID=
MSG91_MESSAGE_VAR=VAR1

# (B) sendsms v2 — free-form text, no template. Simpler for testing, but on a
#     DLT-enforced Indian route the carrier may scrub non-template content.
#     MSG91_SENDER is your approved 6-character sender ID, e.g. RKSHAK.
MSG91_SENDER=
# Route 4 = transactional (reaches DND numbers). 1 = promotional.
MSG91_ROUTE=4
MSG91_COUNTRY=91
# Optional DLT template entity ID, if your account requires it on route 4.
MSG91_DLT_TE_ID=
# Optional: HTTP timeout for MSG91 calls, in ms.
MSG91_TIMEOUT_MS=12000

# ---------------------------------------------------------------------------
# Twilio — the AI voice call  (https://www.twilio.com/console)
# ---------------------------------------------------------------------------
# Sign up free and verify your own phone number for trial-account testing.
# Note: Twilio trial accounts block custom voice TwiML entirely, so you must
# upgrade (add billing) before the spoken alert message will actually play.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio phone number capable of voice calls, in E.164 format, e.g. +15551234567
TWILIO_VOICE_FROM=
# Only needed if you set SMS_PROVIDER=twilio to fall back to Twilio for SMS.
TWILIO_SMS_FROM=
