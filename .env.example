# ---------------------------------------------------------------------------
# FRONTEND environment (Vite). Copy to .env in the project root.
# ---------------------------------------------------------------------------
# Only VITE_-prefixed vars reach the browser bundle, and everything here is a
# public URL — never put an API key in this file. Telecom credentials live in
# server/.env (MSG91 + Twilio) and data-provider keys in backend/.env.

# URL of the alerts backend (custom SMS via MSG91 + AI voice call via Twilio)
# — see server/README.md. Defaults to http://localhost:5000 if unset.
VITE_ALERTS_BACKEND_URL=http://localhost:5000

# Python ML early-warning service — see backend/README.md.
VITE_EARLY_WARNING_API_URL=http://localhost:8000/api/early-warning

# --- Refresh intervals (milliseconds) ---
# The Python backend answers from a pre-built snapshot kept warm by a
# background thread, so a 2-second poll on the AI Early Warning tab costs it
# almost nothing. Raise these if you point the frontend at a slow remote host.
VITE_EARLY_WARNING_POLL_MS=2000
# The header status pill is a summary, so it polls a little more slowly.
VITE_HEADER_STATUS_POLL_MS=5000
# Live Alerts calls third-party public APIs (USGS, GDACS) straight from the
# browser, so this stays a courteous interval.
VITE_LIVE_ALERTS_POLL_MS=60000
